{
  "name": "smart-ris-root",
  "description": "Highly versatile, fault-tolerant RIS (Research Information Systems) format parser, stringifier, and record builder suite for JavaScript and TypeScript.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smart-ris-js/smart-ris.git"
  },
  "bugs": {
    "url": "https://github.com/smart-ris-js/smart-ris/issues"
  },
  "homepage": "https://github.com/smart-ris-js/smart-ris#readme",
  "author": "Martin Winkler",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "clean": "tsc -b --clean && bun run --filter \"@smart-ris/*\" clean",
    "build": "bun run clean && bun run build:types && bun run build:js",
    "build:types": "tsc -b",
    "build:js": "bun run --filter \"@smart-ris/*\" build:js",
    "test": "bun run build && bun test && bun run test:types",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:dist": "bun run --filter \"@smart-ris/*\" test:dist",
    "test:package": "bun run --filter \"@smart-ris/*\" test:package",
    "coverage": "bun test --coverage",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci --error-on-warnings .",
    "check": "bun run lint:ci && bun run build && bun run test:types && bun test && bun run test:dist && bun run test:package",
    "ai": "bun run .ai/ai.ts",
    "test:parse": "bun test --cwd packages/parse",
    "test:stringify": "bun test --cwd packages/stringify",
    "test:inspect-parse": "bun test --cwd packages/inspect-parse"
  },
  "devDependencies": {
    "@smart-ris/core": "workspace:*",
    "@smart-ris/inspect-parse": "workspace:*",
    "@smart-ris/parse": "workspace:*",
    "@smart-ris/stringify": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.12.0",
    "typescript": "^7.0.2"
  }
}
