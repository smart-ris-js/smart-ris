{
  "name": "@smart-ris/inspect-parse",
  "version": "0.2.5",
  "description": "Forensic inspection and diagnostic anomaly reporting engine for RIS (Research Information Systems) format files.",
  "keywords": [
    "smart-ris",
    "inspect-parse"
  ],
  "author": "Martin Winkler",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smart-ris-js/smart-ris.git",
    "directory": "packages/inspect-parse"
  },
  "bugs": {
    "url": "https://github.com/smart-ris-js/smart-ris/issues"
  },
  "homepage": "https://github.com/smart-ris-js/smart-ris#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "bun run clean && bun run build:types && bun run build:js",
    "build:types": "tsc -b",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external --sourcemap=linked --banner=\"/*! Copyright 2026 Martin Winkler */\"",
    "test": "bun test",
    "test:dist": "node tests/smoke/smoke.mjs && node tests/smoke/smoke.cjs",
    "test:package": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@smart-ris/core": "workspace:>=0.8.1 <1.0.0",
    "@smart-ris/parse": "workspace:>=0.12.1 <1.0.0"
  }
}
